# Copy this file to .env.local for local work. On Vercel, add the same names
# under Project > Settings > Environment Variables. See SETUP.md.

# --- Supabase: the SAME project the accel-elite.asia site uses ---
# Requests from the invitation form are saved to its "applications" table,
# so they appear in the existing admin panel.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-only. Never expose this key in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Resend: notification emails ---
RESEND_API_KEY=your-resend-api-key
APPLICATIONS_FROM_EMAIL=Accel Elite <apply@accel-elite.asia>
APPLICATIONS_NOTIFY_EMAIL=membership@accel-elite.asia
CONTACT_NOTIFY_EMAIL=enquiry@accel-elite.asia

# --- Links ---
# Where "Member sign in" goes. The member area stays on accel-elite.asia for launch.
NEXT_PUBLIC_MEMBER_LOGIN_URL=https://accel-elite.asia/login

# --- Search engines ---
# The site can be listed by Google by default. Set to "false" to hide it.
NEXT_PUBLIC_ALLOW_INDEXING=
